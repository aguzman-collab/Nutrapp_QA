{
  "devDependencies": {
    "cypress": "^15.11.0",
    "cypress-xpath": "^2.0.1",
    "dotenv": "^17.3.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "puppeteer": "^24.39.1",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "clean:reports": "rimraf cypress/reports",
    "merge-reports": "mochawesome-merge cypress/reports/.jsons/*.json > cypress/reports/mochawesome.json",
    "generate-html": "marge cypress/reports/mochawesome.json --reportDir cypress/reports --reportFilename index",
    "report:pdf": "rimraf cypress/reports && cypress run --spec cypress/e2e/nutraapp.cy.js && node cypress/scripts/generate-pdf.js"
  },
  "dependencies": {
    "cypress-mochawesome-reporter": "^4.0.2"
  }
}
